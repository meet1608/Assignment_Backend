<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset Password Email</title>
  <style>
    body { background-color: #f3f4f6; font-family: 'Segoe UI', sans-serif; color: #1f2937; }
    .container { max-width: 500px; margin: 40px auto; background: #fff; padding: 30px; border-radius: 12px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08); }
    .button { display: inline-block; padding: 10px 20px; background-color: #3b82f6; color: #fff; text-decoration: none; border-radius: 4px; }
  </style>
</head>
<body>
  <div class="container">
    <h2>Reset Your Password</h2>
    <p>Click the button below to reset your password:</p>
    <a href="http://localhost:5173/reset-password?token=<%= token %>" class="button">Reset Password</a>
  </div>
</body>
</html>
